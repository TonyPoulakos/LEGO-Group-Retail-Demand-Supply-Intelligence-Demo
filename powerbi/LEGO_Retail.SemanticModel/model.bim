        ],
        "partitions": [
          {
            "name": "gold_fact_forecast",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Embedded = Binary.Decompress(Binary.FromText(Text.Combine({\"\",\"\",\"\"}), BinaryEncoding.Base64), Compression.GZip),",
                "    Source = Csv.Document(Embedded, [Delimiter=\",\", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"store_id\", Int64.Type}, {\"product_id\", Int64.Type}, {\"weekday\", Int64.Type}, {\"date\", type date}, {\"demand_units\", Int64.Type}, {\"forecast_units\", type number}, {\"forecast_origin\", type date}, {\"absolute_error\", type number}, {\"signed_error\", type number}, {\"model_name\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Forecast Units",
            "expression": "SUM(gold_fact_forecast[forecast_units])",
            "formatString": "#,0.0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Holdout Actual Demand",
            "expression": "SUM(gold_fact_forecast[demand_units])",
            "formatString": "#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Forecast WAPE",
            "expression": "DIVIDE(SUM(gold_fact_forecast[absolute_error]), [Holdout Actual Demand])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Forecast"
          },
          {
            "name": "Forecast Bias",
            "expression": "DIVIDE(SUM(gold_fact_forecast[signed_error]), [Holdout Actual Demand])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Forecast"
          },
          {
            "name": "Holdout Days",
            "expression": "DISTINCTCOUNT(gold_fact_forecast[date])",
            "formatString": "0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Forecast Records",
            "expression": "COUNTROWS(gold_fact_forecast)",
            "formatString": "#,0",
            "displayFolder": "Forecast"
          }
        ]
      },
