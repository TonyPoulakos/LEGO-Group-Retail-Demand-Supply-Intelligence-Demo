        ],
        "partitions": [
          {
            "name": "gold_fact_daily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Embedded = Binary.Decompress(Binary.FromText(Text.Combine({\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"}), BinaryEncoding.Base64), Compression.GZip),",
                "    Source = Csv.Document(Embedded, [Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"date\", type date}, {\"store_id\", Int64.Type}, {\"product_id\", Int64.Type}, {\"sales_units\", Int64.Type}, {\"demand_units\", Int64.Type}, {\"sales_amount\", type number}, {\"unit_price\", type number}, {\"promo_flag\", Int64.Type}, {\"opening_units\", Int64.Type}, {\"received_units\", Int64.Type}, {\"closing_units\", Int64.Type}, {\"lost_units\", Int64.Type}, {\"stockout_exposure\", type number}, {\"available_flag\", Int64.Type}, {\"stockout_flag\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue USD",
            "expression": "SUM(gold_fact_daily[sales_amount])",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "displayFolder": "KPIs"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(gold_fact_daily[sales_units])",
            "formatString": "#,0",
            "displayFolder": "KPIs"
          },
          {
            "name": "Simulated Demand Units",
            "expression": "SUM(gold_fact_daily[demand_units])",
            "formatString": "#,0",
            "displayFolder": "KPIs"
          },
          {
            "name": "Consumer Demand Fill Rate",
            "expression": "DIVIDE([Units Sold], [Simulated Demand Units])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "KPIs"
          },
          {
            "name": "Daily Availability Rate",
            "expression": "DIVIDE(SUM(gold_fact_daily[available_flag]), COUNTROWS(gold_fact_daily))",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "KPIs"
          },
          {
            "name": "Stockout Day Rate",
            "expression": "DIVIDE(SUM(gold_fact_daily[stockout_flag]), COUNTROWS(gold_fact_daily))",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "KPIs"
          },
          {
            "name": "Lost Demand Units",
            "expression": "SUM(gold_fact_daily[lost_units])",
            "formatString": "#,0",
            "displayFolder": "KPIs"
          },
          {
            "name": "Modeled Stockout Exposure USD",
            "expression": "SUM(gold_fact_daily[stockout_exposure])",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "displayFolder": "KPIs"
          },
          {
            "name": "Closing Inventory Units",
            "expression": "VAR LastVisibleFactDate = MAX(gold_fact_daily[date]) RETURN CALCULATE(SUM(gold_fact_daily[closing_units]), REMOVEFILTERS(gold_dim_date), gold_fact_daily[date] = LastVisibleFactDate)",
            "formatString": "#,0",
            "displayFolder": "KPIs"
          }
        ]
      },
